#!/bin/sh
# Vendors GitHub's GraphQL schema into crates/github/graphql/schema.graphql, from the github/docs
# repository, pinned by commit. GitHub updates that copy daily; the octokit/graphql-schema package
# stopped updating in 2025.
#
# Usage: script/update-github-schema [<github/docs commit>]
#
# Without a commit, it takes the head of github/docs's main branch. It then validates Lo's
# queries against the new schema and builds the github crate, so a schema change that breaks a
# query fails here, and in the PR that commits the new schema.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
schema="$root/crates/github/graphql/schema.graphql"
source_path=src/graphql/data/fpt/schema.docs.graphql

commit=${1:-}
if [ -z "$commit" ]; then
  commit=$(git ls-remote https://github.com/github/docs.git refs/heads/main | cut -f1)
fi
case "$commit" in
  *[!0-9a-f]* | '')
    echo "update-github-schema: not a commit: $commit" >&2
    exit 1
    ;;
esac

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
{
  echo "# GitHub's public GraphQL schema, from github/docs@$commit ($source_path)."
  echo "# Generated by script/update-github-schema; don't edit by hand."
  curl --fail --silent --show-error --location \
    "https://raw.githubusercontent.com/github/docs/$commit/$source_path"
} >"$tmp"
mv "$tmp" "$schema"
trap - EXIT
echo "update-github-schema: wrote $schema from github/docs@$commit"

cd "$root"
cargo test -p github graphql_schema
cargo build -p github
